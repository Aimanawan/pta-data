              "});\r",
              "\r",
              "// Test 2: Check krna ke response time 3 seconds se kam ho (Performance Test)\r",
              "pm.test(\"Response time is less than 3000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
